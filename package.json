{
  "name": "potion-siege",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:crazygames": "vite --config vite.crazygames.config.js",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --config vite.crazygames.config.js",
    "dev:playgama": "vite --config vite.playgama.config.js",
    "build:playgama": "tsc --noEmit && vite build --config vite.playgama.config.js && (python3 scripts/pack_playgama.py || python scripts/pack_playgama.py)",
    "preview:playgama": "vite preview --config vite.playgama.config.js --port 4175 --strictPort",
    "dev:ios": "vite --config vite.ios.config.js",
    "build:ios": "tsc --noEmit && vite build --config vite.ios.config.js",
    "preview:crazygames": "vite preview --config vite.crazygames.config.js --port 4174 --strictPort",
    "build:itch": "tsc --noEmit && node scripts/build-zip.mjs itch",
    "build:newgrounds": "tsc --noEmit && node scripts/build-zip.mjs newgrounds",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run --config scripts/vitest.balance.config.js",
    "check": "npm run typecheck && npm run check:filelength && npm run test && npm run check:balance:quick && npm run build:crazygames && npm run build:playgama && npm run build:ios",
    "check:filelength": "node scripts/checkFileLength.mjs",
    "mutate": "stryker run",
    "check:balance": "vitest run --config scripts/vitest.guard.config.js",
    "check:balance:quick": "vitest run --config scripts/vitest.guard.config.js lazy endless",
    "check:balance:slow": "vitest run --config scripts/vitest.guard.config.js early chapters bosses",
    "collector": "node scripts/collector.mjs",
    "report": "node scripts/report.mjs",
    "early": "vitest run --config scripts/vitest.early.config.js",
    "late": "vitest run --config scripts/vitest.late.config.js",
    "lazy": "vitest run --config scripts/vitest.lazy.config.js",
    "bosses": "vitest run --config scripts/vitest.bosses.config.js",
    "stars": "vitest run --config scripts/vitest.stars.config.js",
    "endless": "vitest run --config scripts/vitest.endless.config.js",
    "economy": "node scripts/economy.mjs",
    "firstframe": "node scripts/firstFrame.mjs",
    "framecost": "node scripts/frameCost.mjs",
    "chapters": "vitest run --config scripts/vitest.chapters.config.js",
    "memruns": "node scripts/memRuns.mjs",
    "contextloss": "node scripts/contextLoss.mjs",
    "sweep": "vitest run --config scripts/vitest.sweep.config.js",
    "targeting": "vitest run --config scripts/vitest.targeting.config.js",
    "smoke": "node scripts/smoke.mjs",
    "replays": "vitest run --config scripts/vitest.replays.config.js",
    "gaps": "vitest run --config scripts/vitest.gaps.config.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capgo/capacitor-updater": "8.52.1",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
