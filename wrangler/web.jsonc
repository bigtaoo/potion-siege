{
  // Static hosting (Cloudflare Workers static assets) for the web build of Potion Siege,
  // served at p.gamestao.com. Mirrors D:\standing's wrangler/web.jsonc (same gamestao.com
  // account).
  //
  // Build (outputs dist):          npm run build
  // Deploy (from the repo root):   npx wrangler deploy -c wrangler/web.jsonc
  //
  // routes[].custom_domain=true provisions the DNS record and edge certificate on the first
  // deploy. The game sends telemetry to ps.gamestao.com (server/, CORS is open there).
  "name": "potion-siege-web",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "p.gamestao.com", "custom_domain": true }
  ]
}
